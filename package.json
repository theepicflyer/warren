{
  "name": "warren",
  "version": "0.1.0",
  "private": true,
  "description": "Shared framework for the household's apps: one container, one SQLite file, an in-app Claude agent and an MCP server over the same tools.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "exports": {
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    }
  },
  "bin": {
    "warren": "dist/server/cli.js"
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:pocketid": "vitest run --config vitest.pocketid.config.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@hono/node-server": "^2.1.8",
    "better-sqlite3": "^13.1.1",
    "drizzle-orm": "^0.45.4",
    "fastmcp": "^4.26.2",
    "hono": "^4.13.18",
    "jose": "^6.2.17",
    "openid-client": "^6.9.0",
    "sharp": "^0.35.5",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
